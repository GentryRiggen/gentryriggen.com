rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The UID is the real pin (an email address can be claimed or changed, a
    // UID cannot). The provider pin limits access to email/password sign-in.
    // Keep the UID in sync with ADMIN_UID in lib/analytics/admin.ts.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "nmt3n9sdfCX2NfzVlTdyXsWzHqm2"
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function validPageview() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ts', 'site', 'path', 'ref', 'device', 'browser', 'os', 'screen', 'tz', 'vid'])
        && d.keys().hasAll(['ts', 'site', 'path', 'ref', 'device', 'browser', 'os', 'screen', 'tz', 'vid'])
        && d.ts == request.time
        && d.site in ['home', 'ship-builder', 'plane-builder']
        && d.path is string
        && ((d.site == 'home' && d.path == '/')
          || (d.site == 'ship-builder' && d.path.matches('^/ship-builder(/.*)?$'))
          || (d.site == 'plane-builder' && d.path.matches('^/plane-builder(/.*)?$')))
        && d.path is string && d.path.size() > 0 && d.path.size() <= 200
        && d.ref is string && d.ref.size() <= 100
        && d.device in ['mobile', 'tablet', 'desktop']
        && d.browser is string && d.browser.size() > 0 && d.browser.size() <= 30
        && d.os is string && d.os.size() > 0 && d.os.size() <= 30
        && d.screen in ['<640', '640-1023', '1024-1439', '1440+']
        && d.tz is string && d.tz.size() <= 64
        && d.vid is string && d.vid.size() >= 8 && d.vid.size() <= 64;
    }

    match /pageviews/{id} {
      allow read: if isAdmin();
      allow create: if id.size() <= 64 && validPageview();
      allow update, delete: if false;
    }

    // ---- Plane Builder leaderboard -------------------------------------
    // Keep the word lists in sync with lib/leaderboard/nickname.ts and the
    // minimum times with floor(finishDistance / MAX_SPEED) per world in
    // lib/plane-builder (both are checked by firestore-tests/sync.test.ts).

    function validNickname(n) {
      let adjectives = ['Happy', 'Sunny', 'Brave', 'Clever', 'Gentle', 'Jolly', 'Lucky', 'Swift', 'Bright', 'Cheery', 'Cosmic', 'Fluffy', 'Friendly', 'Mighty', 'Merry', 'Nimble', 'Plucky', 'Quick', 'Snappy', 'Speedy', 'Zippy', 'Breezy', 'Calm', 'Cozy', 'Daring', 'Eager', 'Fancy', 'Glad', 'Golden', 'Grand', 'Kind', 'Lively', 'Peppy', 'Proud', 'Silly', 'Smiley', 'Sparkly', 'Steady', 'Warm', 'Witty'];
      let animals = ['Otter', 'Panda', 'Koala', 'Puffin', 'Fox', 'Owl', 'Bunny', 'Duck', 'Penguin', 'Dolphin', 'Turtle', 'Falcon', 'Eagle', 'Robin', 'Sparrow', 'Hawk', 'Seal', 'Whale', 'Llama', 'Alpaca', 'Badger', 'Beaver', 'Hedgehog', 'Kitten', 'Puppy', 'Pony', 'Lemur', 'Gecko', 'Parrot', 'Toucan', 'Walrus', 'Wombat', 'Squirrel', 'Raccoon', 'Giraffe', 'Zebra', 'Moose', 'Bison', 'Heron', 'Swan'];
      return n is string && n.size() <= 40
        && n.split(' ').size() == 3
        && n.split(' ')[0] in adjectives
        && n.split(' ')[1] in animals
        && n.split(' ')[2].matches('[1-9][0-9]?');
    }

    // A world's best time is optional; when present it is a number between
    // the physical minimum (finishDistance / MAX_SPEED, rounded down) and 600.
    function validTime(times, world, minSeconds) {
      return !(world in times)
        || (times[world] is number
          && times[world] >= minSeconds
          && times[world] <= 600);
    }

    function validBestTimes(t) {
      return t is map
        && t.keys().hasOnly(['meadow', 'canyon', 'mountains', 'beach', 'jungle', 'city', 'glacier', 'volcano', 'storm', 'islands'])
        && validTime(t, 'meadow', 16)
        && validTime(t, 'canyon', 33)
        && validTime(t, 'mountains', 50)
        && validTime(t, 'beach', 58)
        && validTime(t, 'jungle', 61)
        && validTime(t, 'city', 65)
        && validTime(t, 'glacier', 68)
        && validTime(t, 'volcano', 70)
        && validTime(t, 'storm', 73)
        && validTime(t, 'islands', 75);
    }

    // min(floor(distance), 999999999), as in lib/leaderboard/types.ts.
    function cappedDistance(distance) {
      return math.floor(distance) > 999999999 ? 999999999 : math.floor(distance);
    }

    function isPlayer(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function validLeaderboard() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nickname', 'prestige', 'score', 'lifetimeDistance', 'bestTimes', 'fastestRun', 'updatedAt'])
        && d.keys().hasAll(['nickname', 'prestige', 'score', 'lifetimeDistance', 'bestTimes', 'fastestRun', 'updatedAt'])
        && validNickname(d.nickname)
        && d.prestige is int && d.prestige >= 0 && d.prestige <= 10000
        && d.lifetimeDistance is number
        && d.lifetimeDistance >= 0 && d.lifetimeDistance <= 1000000000000
        && d.score is int
        && d.score == d.prestige * 1000000000 + cappedDistance(d.lifetimeDistance)
        && validBestTimes(d.bestTimes)
        && (d.fastestRun == null
          || (d.fastestRun is int && d.fastestRun >= 10 && d.fastestRun <= 100000))
        && d.updatedAt == request.time;
    }

    // 68800 = sum of every world's finishDistance (checked by
    // lib/leaderboard/__tests__/rulesSync.test.ts). A full run needs all of it.
    // Coherence: a fastestRun needs every world's best time and a full run's
    // worth of distance.
    function coherent() {
      let d = request.resource.data;
      return d.fastestRun == null
        || (d.bestTimes.keys().hasAll(['meadow', 'canyon', 'mountains', 'beach', 'jungle', 'city', 'glacier', 'volcano', 'storm', 'islands'])
          && d.lifetimeDistance >= 68800);
    }

    function notBanned(uid) {
      return !exists(/databases/$(database)/documents/leaderboardBans/$(uid));
    }

    // A first write is a fresh or migrated player: at most one prestige (a
    // migrated v2 save can prestige once with almost no distance).
    function validLeaderboardCreate(uid) {
      let d = request.resource.data;
      return d.prestige <= 1
        && d.lifetimeDistance <= 150000
        && coherent()
        && notBanned(uid);
    }

    // Prestige must be earned by distance (one free prestige for migrated
    // saves) and distance can grow no faster than the game can fly: at most
    // 180 m per real second (MAX_SPEED 120 * GAME_SPEED 1.5), plus the 9100 m
    // one flight can add, with a little slack in the per-second figure.
    function validLeaderboardUpdate(uid) {
      let d = request.resource.data;
      let old = resource.data;
      let secs = (request.time.toMillis() - old.updatedAt.toMillis()) / 1000;
      return d.prestige >= old.prestige
        && (d.prestige - 1) * 68800 <= d.lifetimeDistance
        && d.lifetimeDistance >= old.lifetimeDistance
        && d.lifetimeDistance <= old.lifetimeDistance + 200 * secs + 9100
        && secs >= 10
        && coherent()
        && notBanned(uid);
    }

    match /leaderboard/{uid} {
      allow get: if true;
      allow list: if request.query.limit <= 50 && request.query.offset == 0;
      allow create: if isPlayer(uid) && validLeaderboard() && validLeaderboardCreate(uid);
      allow update: if isPlayer(uid) && validLeaderboard() && validLeaderboardUpdate(uid);
      allow delete: if isAdmin();
    }

    // Players removed from the leaderboard by the admin. A ban document stops
    // the player's anonymous uid from writing leaderboard/{uid} again.
    match /leaderboardBans/{uid} {
      allow read, write: if isAdmin();
    }

    // ---- Ship Builder leaderboard --------------------------------------
    // shipLeaderboard/{uid}: total stars across a player's designs plus their
    // best value per challenge (lib/ship-builder/challenges). Keep the star
    // thresholds in sync with starAt in challenges/definitions.ts (checked by
    // lib/leaderboard/__tests__/rulesSync.test.ts).

    // Stars a best value earns; a challenge that was never played is 0.
    function starsOf(b, id, one, two, three) {
      return !(id in b) ? 0
        : b[id] >= three ? 3
        : b[id] >= two ? 2
        : b[id] >= one ? 1
        : 0;
    }

    function validShipBests(b) {
      return b is map
        && b.keys().hasOnly(['outlast', 'evacuation', 'shipshape'])
        && (!('outlast' in b) || (b.outlast is int && b.outlast >= 0 && b.outlast <= 1440))
        && (!('evacuation' in b) || (b.evacuation is int && b.evacuation >= 0 && b.evacuation <= 100))
        && (!('shipshape' in b) || (b.shipshape is int && b.shipshape >= 0 && b.shipshape <= 3));
    }

    function validShipLeaderboard() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nickname', 'totalStars', 'bests', 'updatedAt'])
        && d.keys().hasAll(['nickname', 'totalStars', 'bests', 'updatedAt'])
        && validNickname(d.nickname)
        && d.totalStars is int && d.totalStars >= 1 && d.totalStars <= 4500
        && validShipBests(d.bests)
        // A player with stars has a best to show for them, and every best was
        // earned on some design, so the total is at least the stars of those
        // bests.
        && d.bests.size() > 0
        && d.totalStars >= starsOf(d.bests, 'outlast', 60, 160, 1440)
          + starsOf(d.bests, 'evacuation', 25, 75, 100)
          + starsOf(d.bests, 'shipshape', 1, 2, 3)
        && d.updatedAt == request.time;
    }

    // A first write may carry the stars of a few trials played offline.
    function validShipCreate(uid) {
      return request.resource.data.totalStars <= 60 && notBanned(uid);
    }

    // Stars can grow no faster than the game can award them: at most 3 per
    // trial and a trial takes over 20 seconds, so 6 plus 1 per 5 seconds of
    // slack, and never more than 9 (one design's maximum) in a single write,
    // so idle time cannot be banked into one big jump. They may fall when a
    // ship is deleted. Writes are 10 s apart.
    function validShipUpdate(uid) {
      let d = request.resource.data;
      let old = resource.data;
      let secs = (request.time.toMillis() - old.updatedAt.toMillis()) / 1000;
      return secs >= 10
        && d.totalStars <= old.totalStars + (secs / 5 < 3 ? 6 + secs / 5 : 9)
        && notBanned(uid);
    }

    match /shipLeaderboard/{uid} {
      allow get: if true;
      allow list: if request.query.limit <= 50 && request.query.offset == 0;
      allow create: if isPlayer(uid) && validShipLeaderboard() && validShipCreate(uid);
      allow update: if isPlayer(uid) && validShipLeaderboard() && validShipUpdate(uid);
      allow delete: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
