rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The UID is the real pin (an email address can be claimed or changed, a
    // UID cannot). The provider pin limits access to email/password sign-in.
    // Keep the UID in sync with ADMIN_UID in lib/analytics/admin.ts.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "nmt3n9sdfCX2NfzVlTdyXsWzHqm2"
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function validPageview() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ts', 'site', 'path', 'ref', 'device', 'browser', 'os', 'screen', 'tz', 'vid'])
        && d.keys().hasAll(['ts', 'site', 'path', 'ref', 'device', 'browser', 'os', 'screen', 'tz', 'vid'])
        && d.ts == request.time
        && d.site in ['home', 'ship-builder', 'plane-builder']
        && d.path is string
        && ((d.site == 'home' && d.path == '/')
          || (d.site == 'ship-builder' && d.path.matches('^/ship-builder(/.*)?$'))
          || (d.site == 'plane-builder' && d.path.matches('^/plane-builder(/.*)?$')))
        && d.path is string && d.path.size() > 0 && d.path.size() <= 200
        && d.ref is string && d.ref.size() <= 100
        && d.device in ['mobile', 'tablet', 'desktop']
        && d.browser is string && d.browser.size() > 0 && d.browser.size() <= 30
        && d.os is string && d.os.size() > 0 && d.os.size() <= 30
        && d.screen in ['<640', '640-1023', '1024-1439', '1440+']
        && d.tz is string && d.tz.size() <= 64
        && d.vid is string && d.vid.size() >= 8 && d.vid.size() <= 64;
    }

    match /pageviews/{id} {
      allow read: if isAdmin();
      allow create: if id.size() <= 64 && validPageview();
      allow update, delete: if false;
    }

    // ---- Plane Builder leaderboard -------------------------------------
    // Keep the word lists in sync with lib/leaderboard/nickname.ts and the
    // minimum times with floor(finishDistance / MAX_SPEED) per world in
    // lib/plane-builder (both are checked by firestore-tests/sync.test.ts).

    function validNickname(n) {
      let adjectives = ['Happy', 'Sunny', 'Brave', 'Clever', 'Gentle', 'Jolly', 'Lucky', 'Swift', 'Bright', 'Cheery', 'Cosmic', 'Fluffy', 'Friendly', 'Mighty', 'Merry', 'Nimble', 'Plucky', 'Quick', 'Snappy', 'Speedy', 'Zippy', 'Breezy', 'Calm', 'Cozy', 'Daring', 'Eager', 'Fancy', 'Glad', 'Golden', 'Grand', 'Kind', 'Lively', 'Peppy', 'Proud', 'Silly', 'Smiley', 'Sparkly', 'Steady', 'Warm', 'Witty'];
      let animals = ['Otter', 'Panda', 'Koala', 'Puffin', 'Fox', 'Owl', 'Bunny', 'Duck', 'Penguin', 'Dolphin', 'Turtle', 'Falcon', 'Eagle', 'Robin', 'Sparrow', 'Hawk', 'Seal', 'Whale', 'Llama', 'Alpaca', 'Badger', 'Beaver', 'Hedgehog', 'Kitten', 'Puppy', 'Pony', 'Lemur', 'Gecko', 'Parrot', 'Toucan', 'Walrus', 'Wombat', 'Squirrel', 'Raccoon', 'Giraffe', 'Zebra', 'Moose', 'Bison', 'Heron', 'Swan'];
      return n is string && n.size() <= 40
        && n.split(' ').size() == 3
        && n.split(' ')[0] in adjectives
        && n.split(' ')[1] in animals
        && n.split(' ')[2].matches('[1-9][0-9]?');
    }

    // A world's best time is optional; when present it is a number between
    // the physical minimum (finishDistance / MAX_SPEED, rounded down) and 600.
    function validTime(times, world, minSeconds) {
      return !(world in times)
        || (times[world] is number
          && times[world] >= minSeconds
          && times[world] <= 600);
    }

    function validBestTimes(t) {
      return t is map
        && t.keys().hasOnly(['meadow', 'canyon', 'mountains', 'beach', 'jungle', 'city', 'glacier', 'volcano', 'storm', 'islands'])
        && validTime(t, 'meadow', 16)
        && validTime(t, 'canyon', 33)
        && validTime(t, 'mountains', 50)
        && validTime(t, 'beach', 58)
        && validTime(t, 'jungle', 61)
        && validTime(t, 'city', 65)
        && validTime(t, 'glacier', 68)
        && validTime(t, 'volcano', 70)
        && validTime(t, 'storm', 73)
        && validTime(t, 'islands', 75);
    }

    // min(floor(distance), 999999999), as in lib/leaderboard/types.ts.
    function cappedDistance(distance) {
      return math.floor(distance) > 999999999 ? 999999999 : math.floor(distance);
    }

    function isPlayer(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function validLeaderboard() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nickname', 'prestige', 'score', 'lifetimeDistance', 'bestTimes', 'fastestRun', 'updatedAt'])
        && d.keys().hasAll(['nickname', 'prestige', 'score', 'lifetimeDistance', 'bestTimes', 'fastestRun', 'updatedAt'])
        && validNickname(d.nickname)
        && d.prestige is int && d.prestige >= 0 && d.prestige <= 10000
        && d.lifetimeDistance is number
        && d.lifetimeDistance >= 0 && d.lifetimeDistance <= 1000000000000
        && d.score is int
        && d.score == d.prestige * 1000000000 + cappedDistance(d.lifetimeDistance)
        && validBestTimes(d.bestTimes)
        && (d.fastestRun == null
          || (d.fastestRun is int && d.fastestRun >= 10 && d.fastestRun <= 100000))
        && d.updatedAt == request.time;
    }

    // 68800 = sum of every world's finishDistance (checked by
    // lib/leaderboard/__tests__/rulesSync.test.ts). A full run needs all of it.
    // Coherence: a fastestRun needs every world's best time and a full run's
    // worth of distance.
    function coherent() {
      let d = request.resource.data;
      return d.fastestRun == null
        || (d.bestTimes.keys().hasAll(['meadow', 'canyon', 'mountains', 'beach', 'jungle', 'city', 'glacier', 'volcano', 'storm', 'islands'])
          && d.lifetimeDistance >= 68800);
    }

    function notBanned(uid) {
      return !exists(/databases/$(database)/documents/leaderboardBans/$(uid));
    }

    // A first write is a fresh or migrated player: at most one prestige (a
    // migrated v2 save can prestige once with almost no distance).
    function validLeaderboardCreate(uid) {
      let d = request.resource.data;
      return d.prestige <= 1
        && d.lifetimeDistance <= 150000
        && coherent()
        && notBanned(uid);
    }

    // Prestige must be earned by distance (one free prestige for migrated
    // saves) and distance can grow no faster than the game can fly: at most
    // 180 m per real second (MAX_SPEED 120 * GAME_SPEED 1.5), plus the 9100 m
    // one flight can add, with a little slack in the per-second figure.
    function validLeaderboardUpdate(uid) {
      let d = request.resource.data;
      let old = resource.data;
      let secs = (request.time.toMillis() - old.updatedAt.toMillis()) / 1000;
      return d.prestige >= old.prestige
        && (d.prestige - 1) * 68800 <= d.lifetimeDistance
        && d.lifetimeDistance >= old.lifetimeDistance
        && d.lifetimeDistance <= old.lifetimeDistance + 200 * secs + 9100
        && secs >= 10
        && coherent()
        && notBanned(uid);
    }

    match /leaderboard/{uid} {
      allow get: if true;
      allow list: if request.query.limit <= 50 && request.query.offset == 0;
      allow create: if isPlayer(uid) && validLeaderboard() && validLeaderboardCreate(uid);
      allow update: if isPlayer(uid) && validLeaderboard() && validLeaderboardUpdate(uid);
      allow delete: if isAdmin();
    }

    // Players removed from the leaderboard by the admin. A ban document stops
    // the player's anonymous uid from writing leaderboard/{uid} again.
    match /leaderboardBans/{uid} {
      allow read, write: if isAdmin();
    }

    // ---- Ship Builder leaderboard --------------------------------------
    // shipLeaderboard/{uid}: total stars across a player's designs plus their
    // best value per challenge (lib/ship-builder/challenges). Keep the star
    // thresholds in sync with starAt in challenges/definitions.ts (checked by
    // lib/leaderboard/__tests__/rulesSync.test.ts).

    // Stars a best value earns; a challenge that was never played is 0.
    function starsOf(b, id, one, two, three) {
      return !(id in b) ? 0
        : b[id] >= three ? 3
        : b[id] >= two ? 2
        : b[id] >= one ? 1
        : 0;
    }

    function validShipBests(b) {
      return b is map
        && b.keys().hasOnly(['outlast', 'evacuation', 'shipshape'])
        && (!('outlast' in b) || (b.outlast is int && b.outlast >= 0 && b.outlast <= 1440))
        && (!('evacuation' in b) || (b.evacuation is int && b.evacuation >= 0 && b.evacuation <= 100))
        && (!('shipshape' in b) || (b.shipshape is int && b.shipshape >= 0 && b.shipshape <= 3));
    }

    function validShipLeaderboard() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nickname', 'totalStars', 'bests', 'updatedAt'])
        && d.keys().hasAll(['nickname', 'totalStars', 'bests', 'updatedAt'])
        && validNickname(d.nickname)
        && d.totalStars is int && d.totalStars >= 1 && d.totalStars <= 4500
        && validShipBests(d.bests)
        // A player with stars has a best to show for them, and every best was
        // earned on some design, so the total is at least the stars of those
        // bests.
        && d.bests.size() > 0
        && d.totalStars >= starsOf(d.bests, 'outlast', 60, 160, 1440)
          + starsOf(d.bests, 'evacuation', 25, 75, 100)
          + starsOf(d.bests, 'shipshape', 1, 2, 3)
        && d.updatedAt == request.time;
    }

    // A first write may carry the stars of a few trials played offline.
    function validShipCreate(uid) {
      return request.resource.data.totalStars <= 60 && notBanned(uid);
    }

    // Stars can grow no faster than the game can award them: at most 3 per
    // trial and a trial takes over 20 seconds, so 6 plus 1 per 5 seconds of
    // slack, and never more than 9 (one design's maximum) in a single write,
    // so idle time cannot be banked into one big jump. They may fall when a
    // ship is deleted. Writes are 10 s apart.
    function validShipUpdate(uid) {
      let d = request.resource.data;
      let old = resource.data;
      let secs = (request.time.toMillis() - old.updatedAt.toMillis()) / 1000;
      return secs >= 10
        && d.totalStars <= old.totalStars + (secs / 5 < 3 ? 6 + secs / 5 : 9)
        && notBanned(uid);
    }

    match /shipLeaderboard/{uid} {
      allow get: if true;
      allow list: if request.query.limit <= 50 && request.query.offset == 0;
      allow create: if isPlayer(uid) && validShipLeaderboard() && validShipCreate(uid);
      allow update: if isPlayer(uid) && validShipLeaderboard() && validShipUpdate(uid);
      allow delete: if isAdmin();
    }

    // ---- Plane Builder daily challenge ---------------------------------
    // planeDaily/{yyyy-mm-dd}/entries/{uid}: one best time per pilot per UTC
    // day. The day must be today by the server clock, or yesterday during the
    // first 15 minutes of today (a flight that ends just after midnight).
    // The day's world is fixed by dailyPlan(), the same list as DAILY_PLAN in
    // lib/plane-builder/daily/daily.ts (entry = day number mod 40, where the
    // day number comes from the PATH date). The time must then be at least that
    // world's physical minimum. Keep the minimums in sync with validBestTimes;
    // lib/leaderboard/__tests__/rulesSync.test.ts checks all of it.

    function dayString(t) {
      return string(t.year()) + '-'
        + (t.month() < 10 ? '0' : '') + string(t.month()) + '-'
        + (t.day() < 10 ? '0' : '') + string(t.day());
    }

    function isRecentDay(date) {
      return date == dayString(request.time)
        || (date == dayString(request.time - duration.value(1, 'd'))
          && request.time.toMillis() % 86400000 < 900000);
    }

    function dailyPlan() {
      return [
        'volcano:noBoost',
        'glacier:tailwind',
        'islands:tailwind',
        'glacier:headwind',
        'beach:noBoost',
        'storm:noBoost',
        'volcano:doubleCoins',
        'city:noBoost',
        'islands:headwind',
        'jungle:tailwind',
        'mountains:headwind',
        'jungle:noBoost',
        'islands:noBoost',
        'storm:doubleCoins',
        'beach:headwind',
        'mountains:tailwind',
        'jungle:doubleCoins',
        'storm:headwind',
        'canyon:doubleCoins',
        'meadow:tailwind',
        'volcano:tailwind',
        'islands:doubleCoins',
        'canyon:noBoost',
        'city:doubleCoins',
        'glacier:noBoost',
        'beach:doubleCoins',
        'meadow:doubleCoins',
        'canyon:tailwind',
        'beach:tailwind',
        'canyon:headwind',
        'mountains:doubleCoins',
        'city:headwind',
        'glacier:doubleCoins',
        'jungle:headwind',
        'city:tailwind',
        'mountains:noBoost',
        'meadow:noBoost',
        'volcano:headwind',
        'storm:tailwind',
        'meadow:headwind'
      ];
    }

    // The world of the day named by the path (the date is already checked by
    // isRecentDay, so int() cannot fail on it).
    function dailyWorld(date) {
      let day = int(math.floor(timestamp.date(int(date[0:4]), int(date[5:7]), int(date[8:10])).toMillis() / 86400000));
      return dailyPlan()[day % 40].split(':')[0];
    }

    function dailyMinimum(world) {
      return {
        'meadow': 16, 'canyon': 33, 'mountains': 50, 'beach': 58, 'jungle': 61,
        'city': 65, 'glacier': 68, 'volcano': 70, 'storm': 73, 'islands': 75
      }[world];
    }

    function validDailyEntry(date) {
      let d = request.resource.data;
      return d.keys().hasOnly(['nickname', 'world', 'time', 'updatedAt'])
        && d.keys().hasAll(['nickname', 'world', 'time', 'updatedAt'])
        && validNickname(d.nickname)
        && d.world == dailyWorld(date)
        && d.time is number
        && d.time >= dailyMinimum(d.world)
        && d.time <= 600
        && d.updatedAt == request.time;
    }

    // A pilot may only improve their time, and not faster than once per 10 s.
    function validDailyUpdate() {
      return request.resource.data.time <= resource.data.time
        && request.time - resource.data.updatedAt >= duration.value(10, 's');
    }

    match /planeDaily/{date}/entries/{uid} {
      allow get: if true;
      allow list: if request.query.limit <= 50 && request.query.offset == 0;
      allow create: if isPlayer(uid) && isRecentDay(date)
        && validDailyEntry(date) && notBanned(uid);
      allow update: if isPlayer(uid) && isRecentDay(date)
        && validDailyEntry(date) && validDailyUpdate() && notBanned(uid);
      allow delete: if isAdmin();
    }

    // ---- Gameplay analytics --------------------------------------------
    // gameEvents/{id}: anonymous events from the two games, whose players are
    // children. An event has NO user id, session id or free text: only an
    // enum-and-small-number `props` map with a fixed schema per event name.
    // Create only (never update or delete); only the admin reads. The schema
    // mirrors GAME_EVENTS in lib/analytics/gameEvents.ts; the rules tests
    // (firestore-tests/gameEvents.test.ts) feed every event and every enum
    // value through these rules, so drift fails CI.

    function worlds() {
      return ['meadow', 'canyon', 'mountains', 'beach', 'jungle', 'city', 'glacier', 'volcano', 'storm', 'islands'];
    }

    function isFlag(v) {
      return v is int && v >= 0 && v <= 1;
    }

    function isTenths(v) {
      return v is int && v >= 0 && v <= 10;
    }

    // A crash position bucketed to 50 m, or -1 when the flight did not crash.
    function isCrashX(v) {
      return v is int && v >= -1 && v <= 12000 && (v == -1 || v % 50 == 0);
    }

    function validFlightEnd(p) {
      return p.keys().hasOnly(['world', 'outcome', 'dist', 'crashX', 'obstacle', 'tiers', 'daily'])
        && p.keys().hasAll(['world', 'outcome', 'dist', 'crashX', 'obstacle', 'tiers', 'daily'])
        && p.world in worlds()
        && p.outcome in ['finish', 'crash', 'landed', 'stalled', 'timeout', 'out_of_fuel']
        && isTenths(p.dist)
        && isCrashX(p.crashX)
        && p.obstacle in ['tree', 'barn', 'balloon', 'wall', 'arch', 'bird', 'peak', 'palm', 'skyscraper', 'iceberg', 'cloud', 'none']
        && p.tiers is int && p.tiers >= 0 && p.tiers <= 48
        && isFlag(p.daily);
    }

    function validPlaneEvent(name, p) {
      return (name == 'flight_end' && validFlightEnd(p))
        || (name == 'upgrade_bought'
          && p.keys().hasOnly(['part', 'tier']) && p.keys().hasAll(['part', 'tier'])
          && p.part in ['launcher', 'wings', 'engine', 'fuel', 'body', 'multiplier']
          && p.tier is int && p.tier >= 1 && p.tier <= 8)
        || (name == 'world_unlocked'
          && p.keys().hasOnly(['world']) && p.keys().hasAll(['world'])
          && p.world in worlds())
        || (name == 'daily_played'
          && p.keys().hasOnly(['world', 'twist', 'finished']) && p.keys().hasAll(['world', 'twist', 'finished'])
          && p.world in worlds()
          && p.twist in ['tailwind', 'headwind', 'doubleCoins', 'noBoost']
          && isFlag(p.finished))
        || (name == 'quit_mid_flight'
          && p.keys().hasOnly(['world', 'dist']) && p.keys().hasAll(['world', 'dist'])
          && p.world in worlds()
          && isTenths(p.dist));
    }

    function validShipEvent(name, p) {
      return (name == 'trial_run'
          && p.keys().hasOnly(['kind', 'outcome', 'sea']) && p.keys().hasAll(['kind', 'outcome', 'sea'])
          && p.kind in ['weather', 'iceberg']
          && p.outcome in ['steady', 'recovered', 'capsized', 'afloat', 'sank']
          && p.sea in ['calm', 'choppy', 'stormy'])
        || (name == 'challenge_result'
          && p.keys().hasOnly(['id', 'stars']) && p.keys().hasAll(['id', 'stars'])
          && p.id in ['outlast', 'evacuation', 'shipshape']
          && p.stars is int && p.stars >= 0 && p.stars <= 3)
        || (name == 'template_used'
          && p.keys().hasOnly(['template']) && p.keys().hasAll(['template'])
          && p.template is string && p.template.size() >= 1 && p.template.size() <= 40
          && p.template.matches('^[a-z0-9-]+$'))
        || (name == 'part_placed'
          && p.keys().hasOnly(['category']) && p.keys().hasAll(['category'])
          && p.category in ['decks', 'cabins', 'command', 'funnels', 'masts', 'lifeboats', 'decor', 'lights', 'propulsion', 'naval', 'cargo', 'sails', 'weapons'])
        || (name == 'walk_started'
          && p.keys().hasOnly(['start']) && p.keys().hasAll(['start'])
          && p.start in ['bow', 'middle', 'stern'])
        || (name == 'drive_started'
          && p.keys().hasOnly(['density']) && p.keys().hasAll(['density'])
          && p.density in ['few', 'some', 'many'])
        || (name == 'ship_shared' && p.keys().size() == 0);
    }

    // The client sends its UTC day; the server clock decides what is plausible
    // (today, or a day either side for clock skew).
    function validGameDay(day) {
      return day is string
        && (day == dayString(request.time)
          || day == dayString(request.time - duration.value(1, 'd'))
          || day == dayString(request.time + duration.value(1, 'd')));
    }

    function validGameEvent() {
      let d = request.resource.data;
      return d.keys().hasOnly(['site', 'name', 'props', 'day', 'createdAt'])
        && d.keys().hasAll(['site', 'name', 'props', 'day', 'createdAt'])
        && d.createdAt == request.time
        && validGameDay(d.day)
        && d.name is string && d.name.size() <= 30
        && d.props is map && d.props.size() <= 8
        && ((d.site == 'plane-builder' && validPlaneEvent(d.name, d.props))
          || (d.site == 'ship-builder' && validShipEvent(d.name, d.props)));
    }

    match /gameEvents/{id} {
      allow read: if isAdmin();
      allow create: if id.size() <= 64 && validGameEvent();
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
